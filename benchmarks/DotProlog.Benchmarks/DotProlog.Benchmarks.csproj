<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>DotProlog.Benchmarks</RootNamespace>
        <IsPackable>false</IsPackable>
        <!-- BenchmarkDotNet needs release codegen to produce meaningful numbers. -->
        <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
        <ServerGarbageCollection>false</ServerGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\DotProlog.Compiler\DotProlog.Compiler.csproj" />
    </ItemGroup>
</Project>
