<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>DotProlog.Benchmarks</RootNamespace>
        <IsPackable>false</IsPackable>
        <!-- BenchmarkDotNet needs release codegen to produce meaningful numbers. -->
        <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
        <ServerGarbageCollection>false</ServerGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
        <!-- Roslyn is used only to prepare generated-C# execution benchmarks. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\DotProlog.Compiler\DotProlog.Compiler.csproj" />
        <ProjectReference Include="..\..\src\DotProlog.CodeGen.IL\DotProlog.CodeGen.IL.csproj" />
        <ProjectReference Include="..\..\src\DotProlog.CodeGen.CSharp\DotProlog.CodeGen.CSharp.csproj" />
    </ItemGroup>
</Project>
