<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../../../src/DotProlog.Sdk/Sdk/Sdk.props" />
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>PortablePackages</RootNamespace>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <DotPrologTasksAssembly>$(MSBuildThisFileDirectory)../../../src/DotProlog.Build.Tasks/bin/$(Configuration)/net10.0/DotProlog.Build.Tasks.dll</DotPrologTasksAssembly>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../../src/DotProlog.Compiler/DotProlog.Compiler.csproj" />
        <ProjectReference Include="../../../src/DotProlog.Build.Tasks/DotProlog.Build.Tasks.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>
    <Import Project="../../../src/DotProlog.Sdk/Sdk/Sdk.targets" />
</Project>
