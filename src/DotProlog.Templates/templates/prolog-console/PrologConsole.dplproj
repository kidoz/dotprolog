<Project Sdk="Microsoft.NET.Sdk">

    <!-- Additive: the .NET SDK builds the project, DotProlog.Sdk adds Prolog to it. -->
    <Sdk Name="DotProlog.Sdk" Version="DOTPROLOG_VERSION" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>PrologConsole</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DotProlog.Compiler" Version="DOTPROLOG_VERSION" />
    </ItemGroup>

</Project>
