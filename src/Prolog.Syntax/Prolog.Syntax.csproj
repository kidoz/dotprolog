<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>Prolog.Syntax</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!--
          The operator table is shared language state, not reader-private state: op/3 mutates it at
          run time and the term writer reads it, so it lives in the runtime and the reader takes it
          from there.
        -->
        <ProjectReference Include="..\Prolog.Runtime\Prolog.Runtime.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Prolog.Syntax.Tests" />
    </ItemGroup>
</Project>
