<Project>
    <PropertyGroup>
        <!--
          A test project hosts Microsoft.Testing.Platform, which is an executable. The template
          declares OutputType early enough for Microsoft.NET.Sdk to compute its run command; this
          fallback also covers projects that import these targets before Microsoft.NET.Sdk.targets.
        -->
        <OutputType Condition="'$(DotPrologTestProject)' == 'true'">Exe</OutputType>
        <IsTestProject Condition="'$(DotPrologTestProject)' == 'true'">true</IsTestProject>
        <IsTestingPlatformApplication Condition="'$(DotPrologTestProject)' == 'true'">true</IsTestingPlatformApplication>

        <!--
          The generated entry point starts Microsoft.Testing.Platform itself, so neither the .NET
          SDK nor the platform package should generate a second entry point.
        -->
        <GenerateProgramFile Condition="'$(DotPrologTestProject)' == 'true'">false</GenerateProgramFile>
        <GenerateTestingPlatformEntryPoint Condition="'$(DotPrologTestProject)' == 'true'"
            >false</GenerateTestingPlatformEntryPoint>

        <!-- An application gets a generated entry point; a library only gets its facade. -->
        <_DotPrologGenerateEntryPoint Condition="'$(OutputType)' == 'Exe'">true</_DotPrologGenerateEntryPoint>
        <_DotPrologGenerateEntryPoint Condition="'$(_DotPrologGenerateEntryPoint)' == ''">false</_DotPrologGenerateEntryPoint>

        <StartupObject Condition="'$(_DotPrologGenerateEntryPoint)' == 'true' and '$(StartupObject)' == ''"
            >$(RootNamespace).PrologProgram</StartupObject>
    </PropertyGroup>

    <PropertyGroup>
        <!--
          BaseIntermediateOutputPath rather than IntermediateOutputPath: the latter is not defined
          until Microsoft.Common.CurrentVersion.targets runs, which is after this file is imported,
          and reading it too early silently writes the facade into the project directory. The
          generated text depends only on the .pl and .dpli, so one copy under obj/ serves every
          configuration.
        -->
        <DotPrologGeneratedPath Condition="'$(DotPrologGeneratedPath)' == ''"
            >$(BaseIntermediateOutputPath)prolog\</DotPrologGeneratedPath>
    </PropertyGroup>

    <ItemGroup Condition="'$(EnableDefaultPrologItems)' == 'true'">
        <PrologCompile Include="**\*.pl" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
        <PrologContract Include="**\*.dpli" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
    </ItemGroup>

    <PropertyGroup>
        <!--
          Inside the SDK package the generator sits beside these targets, at ../tasks/. A consumer
          building against the repository sets DotPrologTasksAssembly itself, and that wins.
        -->
        <DotPrologTasksAssembly Condition="'$(DotPrologTasksAssembly)' == ''"
            >$(MSBuildThisFileDirectory)..\tasks\net10.0\DotProlog.Build.Tasks.dll</DotPrologTasksAssembly>
    </PropertyGroup>

    <!--
      Visual Studio and msbuild.exe host .NET tasks out of process. The dotnet CLI can load the same
      task in process, avoiding IPC overhead for ordinary command-line builds.
    -->
    <UsingTask
        TaskName="DotProlog.Build.Tasks.GeneratePrologFacade"
        AssemblyFile="$(DotPrologTasksAssembly)"
        Runtime="NET"
        TaskFactory="TaskHostFactory"
        Condition="'$(MSBuildRuntimeType)' == 'Full'"
    />
    <UsingTask
        TaskName="DotProlog.Build.Tasks.GeneratePrologFacade"
        AssemblyFile="$(DotPrologTasksAssembly)"
        Runtime="NET"
        Condition="'$(MSBuildRuntimeType)' == 'Core'"
    />

    <!--
      Timestamps cannot see a deleted or renamed source: the file is simply absent from the glob,
      and every remaining input is older than the stamp. Writing the input list to a file — only
      when it differs — turns a changed file list into a fresh timestamp the generation target's
      Inputs comparison does see.
    -->
    <Target Name="_DotPrologRecordInputs" BeforeTargets="GeneratePrologFacade">
        <MakeDir Directories="$(DotPrologGeneratedPath)" />

        <WriteLinesToFile
            File="$(DotPrologGeneratedPath).inputs"
            Lines="language-mode=$(DotPrologLanguageMode);flags=$(DotPrologFlags);@(PrologCompile->'%(FullPath)');@(PrologContract->'%(FullPath)')"
            Overwrite="true"
            WriteOnlyWhenDifferent="true"
        />
    </Target>

    <!--
      The facade has to exist before the C# compiler runs, which is why this is hooked ahead of
      CoreCompile rather than as a post-build step. The project file is an input because properties
      it sets, such as RootNamespace, shape the generated code.
    -->
    <Target
        Name="GeneratePrologFacade"
        BeforeTargets="BeforeCompile;CoreCompile"
        Inputs="@(PrologCompile);@(PrologContract);$(DotPrologTasksAssembly);$(MSBuildProjectFullPath);$(DotPrologGeneratedPath).inputs"
        Outputs="$(DotPrologGeneratedPath).generated"
    >
        <Error
            Condition="!Exists('$(DotPrologTasksAssembly)')"
            Text="The facade generator was not found at $(DotPrologTasksAssembly)."
        />

        <MakeDir Directories="$(DotPrologGeneratedPath)" />

        <GeneratePrologFacade
            Sources="@(PrologCompile)"
            Contracts="@(PrologContract)"
            OutputPath="$(DotPrologGeneratedPath)"
            RootNamespace="$(RootNamespace)"
            GenerateEntryPoint="$(_DotPrologGenerateEntryPoint)"
            GenerateTestHost="$(DotPrologTestProject)"
            LanguageMode="$(DotPrologLanguageMode)"
            Flags="$(DotPrologFlags)"
        >
            <Output TaskParameter="GeneratedFiles" ItemName="DotPrologGeneratedCompile" />
        </GeneratePrologFacade>

        <ItemGroup>
            <Compile Include="@(DotPrologGeneratedCompile)" />
            <FileWrites Include="@(DotPrologGeneratedCompile)" />
        </ItemGroup>

        <!--
          Stamped only after the task succeeds. Writing it first would leave a stamp behind when
          generation failed, and the next build would skip generation and fail on missing code.
        -->
        <Touch Files="$(DotPrologGeneratedPath).generated" AlwaysCreate="true" />
        <ItemGroup>
            <FileWrites Include="$(DotPrologGeneratedPath).generated" />
        </ItemGroup>
    </Target>

    <!--
      Incremental builds skip the target above when nothing changed, so the generated file still has
      to reach the compiler.
    -->
    <Target Name="IncludePrologFacade" BeforeTargets="BeforeCompile;CoreCompile" DependsOnTargets="GeneratePrologFacade">
        <ItemGroup>
            <Compile Include="$(DotPrologGeneratedPath)**\*.g.cs" Exclude="@(Compile)" />
        </ItemGroup>
    </Target>

    <!--
      The generated files live outside IntermediateOutputPath, so the incremental-clean cache that
      FileWrites feeds filters them out; without this target they survive a clean.
    -->
    <Target Name="CleanPrologFacade" AfterTargets="Clean">
        <ItemGroup>
            <_DotPrologCleanFile Include="$(DotPrologGeneratedPath)**\*.g.cs" />
            <_DotPrologCleanFile Include="$(DotPrologGeneratedPath).generated;$(DotPrologGeneratedPath).inputs" />
        </ItemGroup>

        <Delete Files="@(_DotPrologCleanFile)" />
    </Target>
</Project>
