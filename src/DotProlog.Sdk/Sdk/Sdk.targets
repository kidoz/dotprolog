<Project>
    <PropertyGroup>
        <!-- An application gets a generated entry point; a library only gets its facade. -->
        <_DotPrologGenerateEntryPoint Condition="'$(OutputType)' == 'Exe'">true</_DotPrologGenerateEntryPoint>
        <_DotPrologGenerateEntryPoint Condition="'$(_DotPrologGenerateEntryPoint)' == ''">false</_DotPrologGenerateEntryPoint>

        <StartupObject Condition="'$(_DotPrologGenerateEntryPoint)' == 'true' and '$(StartupObject)' == ''"
            >$(RootNamespace).PrologProgram</StartupObject>
    </PropertyGroup>

    <PropertyGroup>
        <!--
          BaseIntermediateOutputPath rather than IntermediateOutputPath: the latter is not defined
          until Microsoft.Common.CurrentVersion.targets runs, which is after this file is imported,
          and reading it too early silently writes the facade into the project directory. The
          generated text depends only on the .pl and .dpli, so one copy under obj/ serves every
          configuration.
        -->
        <DotPrologGeneratedPath Condition="'$(DotPrologGeneratedPath)' == ''"
            >$(BaseIntermediateOutputPath)prolog\</DotPrologGeneratedPath>
    </PropertyGroup>

    <ItemGroup Condition="'$(EnableDefaultPrologItems)' == 'true'">
        <PrologCompile Include="**\*.pl" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
        <PrologContract Include="**\*.dpli" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
    </ItemGroup>

    <PropertyGroup>
        <!--
          Inside the SDK package the generator sits beside these targets, at ../tasks/. A consumer
          building against the repository sets DotPrologTasksAssembly itself, and that wins.
        -->
        <DotPrologTasksAssembly Condition="'$(DotPrologTasksAssembly)' == ''"
            >$(MSBuildThisFileDirectory)..\tasks\net10.0\Prolog.Build.Tasks.dll</DotPrologTasksAssembly>
    </PropertyGroup>

    <UsingTask TaskName="Prolog.Build.Tasks.GeneratePrologFacade" AssemblyFile="$(DotPrologTasksAssembly)" />

    <!--
      The facade has to exist before the C# compiler runs, which is why this is hooked ahead of
      CoreCompile rather than as a post-build step.
    -->
    <Target
        Name="GeneratePrologFacade"
        BeforeTargets="BeforeCompile;CoreCompile"
        Inputs="@(PrologCompile);@(PrologContract)"
        Outputs="$(DotPrologGeneratedPath).generated"
    >
        <Error
            Condition="!Exists('$(DotPrologTasksAssembly)')"
            Text="The facade generator was not found at $(DotPrologTasksAssembly)."
        />

        <MakeDir Directories="$(DotPrologGeneratedPath)" />

        <GeneratePrologFacade
            Sources="@(PrologCompile)"
            Contracts="@(PrologContract)"
            OutputPath="$(DotPrologGeneratedPath)"
            RootNamespace="$(RootNamespace)"
            GenerateEntryPoint="$(_DotPrologGenerateEntryPoint)"
        >
            <Output TaskParameter="GeneratedFiles" ItemName="DotPrologGeneratedCompile" />
        </GeneratePrologFacade>

        <ItemGroup>
            <Compile Include="@(DotPrologGeneratedCompile)" />
            <FileWrites Include="@(DotPrologGeneratedCompile)" />
        </ItemGroup>

        <!--
          Stamped only after the task succeeds. Writing it first would leave a stamp behind when
          generation failed, and the next build would skip generation and fail on missing code.
        -->
        <Touch Files="$(DotPrologGeneratedPath).generated" AlwaysCreate="true" />
        <ItemGroup>
            <FileWrites Include="$(DotPrologGeneratedPath).generated" />
        </ItemGroup>
    </Target>

    <!--
      Incremental builds skip the target above when nothing changed, so the generated file still has
      to reach the compiler.
    -->
    <Target Name="IncludePrologFacade" BeforeTargets="BeforeCompile;CoreCompile" DependsOnTargets="GeneratePrologFacade">
        <ItemGroup>
            <Compile Include="$(DotPrologGeneratedPath)**\*.g.cs" Exclude="@(Compile)" />
        </ItemGroup>
    </Target>
</Project>
