{
  "name": "dotprolog",
  "displayName": "DotProlog",
  "description": "DotProlog language services for Prolog on .NET.",
  "version": "0.1.0",
  "publisher": "kidoz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kidoz/dotprolog"
  },
  "engines": {
    "vscode": "^1.91.0",
    "node": ">=22"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "prolog",
    "dotnet",
    "lsp"
  ],
  "main": "./bin/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:dotprolog"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax highlighting is available. Language services require trust because project evaluation and configured server executables can execute code.",
      "restrictedConfigurations": [
        "dotprolog.serverPath",
        "dotprolog.dotnetPath",
        "dotprolog.project"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "The language server requires a local or remote filesystem."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "dotprolog",
        "aliases": [
          "DotProlog"
        ],
        "extensions": [
          ".pl"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "dotprolog-contract",
        "aliases": [
          "DotProlog Contract"
        ],
        "extensions": [
          ".dpli"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "xml",
        "extensions": [
          ".dplproj"
        ]
      }
    ],
    "grammars": [
      {
        "language": "dotprolog",
        "scopeName": "source.dotprolog",
        "path": "./syntaxes/dotprolog.tmLanguage.json"
      },
      {
        "language": "dotprolog-contract",
        "scopeName": "source.dotprolog.contract",
        "path": "./syntaxes/contract.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "dotprolog",
        "path": "./snippets/prolog.json"
      }
    ],
    "commands": [
      {
        "command": "dotprolog.restartServer",
        "title": "DotProlog: Restart Language Server"
      },
      {
        "command": "dotprolog.showOutput",
        "title": "DotProlog: Show Language Server Output"
      },
      {
        "command": "dotprolog.selectProject",
        "title": "DotProlog: Select Project"
      }
    ],
    "configuration": {
      "title": "DotProlog",
      "properties": {
        "dotprolog.serverPath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Absolute path to a dotprolog-lsp executable or DLL. Empty uses the bundled server."
        },
        "dotprolog.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "scope": "window",
          "description": "dotnet executable used to launch a managed server."
        },
        "dotprolog.project": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Selected .dplproj path. Relative paths require exactly one workspace folder. Empty analyzes loose files without evaluating projects."
        },
        "dotprolog.configuration": {
          "type": "string",
          "default": "Debug",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "scope": "window",
          "description": "MSBuild configuration for the selected project."
        },
        "dotprolog.mode": {
          "type": "string",
          "enum": [
            "modern",
            "strict-iso"
          ],
          "default": "modern",
          "scope": "window",
          "description": "Language mode in loose-file sessions. Selected projects supply their own mode and flags."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc --noEmit && node scripts/build.mjs",
    "build:server": "node scripts/server.mjs",
    "test": "npm run compile && node --test bin/unit/*.test.js",
    "test:integration": "npm run compile && node scripts/test.mjs",
    "package": "node scripts/package.mjs",
    "vscode:prepublish": "npm run compile",
    "test:restricted": "npm run compile && node scripts/test.mjs --restricted",
    "format": "prettier --write src scripts ../../tests/DotProlog.VSCode.Tests *.json syntaxes/*.json snippets/*.json README.md",
    "format:check": "prettier --check src scripts ../../tests/DotProlog.VSCode.Tests *.json syntaxes/*.json snippets/*.json README.md"
  },
  "dependencies": {
    "vscode-languageclient": "11.0.0"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "mocha": "12.0.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "glob": "14.0.3"
  }
}
