{
  "comments": {
    "lineComment": "%",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")",
      "notIn": ["string", "comment"]
    },
    {
      "open": "[",
      "close": "]",
      "notIn": ["string", "comment"]
    },
    {
      "open": "{",
      "close": "}",
      "notIn": ["string", "comment"]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": ["string", "comment"]
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": ["string", "comment"]
    },
    {
      "open": "`",
      "close": "`",
      "notIn": ["string", "comment"]
    }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["'", "'"],
    ["\"", "\""],
    ["`", "`"]
  ],
  "wordPattern": "[A-Za-z_\u00c0-\uffff][A-Za-z0-9_\u00c0-\uffff]*",
  "indentationRules": {
    "increaseIndentPattern": ".*(?::-|-->|[([{])\\s*(?:%.*)?$",
    "decreaseIndentPattern": "^\\s*[)\\]}]"
  }
}
