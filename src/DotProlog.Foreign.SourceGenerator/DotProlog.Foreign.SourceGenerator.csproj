<Project
    Sdk="Microsoft.NET.Sdk"
    TreatAsLocalProperty="PublishAot;PublishTrimmed;PublishSingleFile;RuntimeIdentifier;SelfContained"
>
    <PropertyGroup>
        <!-- Restore walks this build-time dependency without ProjectReference property-removal metadata. -->
        <PublishAot>false</PublishAot>
        <PublishTrimmed>false</PublishTrimmed>
        <PublishSingleFile>false</PublishSingleFile>
        <RuntimeIdentifier />
        <SelfContained>false</SelfContained>
        <TargetFramework>netstandard2.0</TargetFramework>
        <RootNamespace>DotProlog.Foreign.SourceGenerator</RootNamespace>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsAotCompatible>false</IsAotCompatible>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
        <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    </ItemGroup>

    <ItemGroup>
        <!-- Match the compiler shipped with the SDK pinned in global.json. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    </ItemGroup>
</Project>
