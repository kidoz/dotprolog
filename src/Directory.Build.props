<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <PropertyGroup>
        <!-- Every shipped component must stay trim- and AOT-clean; see .agents/contexts/conventions/STYLE_PROFILE.md. -->
        <IsAotCompatible>true</IsAotCompatible>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup>
        <!--
          Package identity is DotProlog.*. Prolog.NET, which the original brief proposed, is taken
          on NuGet by an unrelated WAM-based .NET Prolog, and the bare Prolog ID is taken as well.
          See the product scope's resolved decisions.
        -->
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageTags>prolog;logic-programming;wam;language;aot</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/kidoz/dotprolog</PackageProjectUrl>
        <RepositoryUrl>https://github.com/kidoz/dotprolog</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Source Link. The .NET SDK has carried the GitHub provider since .NET 8, so this needs
             settings rather than a package reference. Set ContinuousIntegrationBuild in CI, not
             here: it makes builds deterministic but rewrites local paths, which breaks debugging
             a working tree. -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <!-- The licence is declared as an expression, which NuGet renders itself; only the readme
             has to travel as a file. -->
        <None Include="$(RepositoryRoot)README.md" Pack="true" PackagePath="" Visible="false" />
    </ItemGroup>
</Project>
