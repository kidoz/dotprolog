<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>DotProlog.Runtime</RootNamespace>

        <IsPackable>true</IsPackable>
        <PackageId>DotProlog.Runtime</PackageId>
        <Title>DotProlog runtime</Title>
        <Description>The bytecode virtual machine a DotProlog program runs on: tagged cells, unification, backtracking, and the builtin predicates. NativeAOT-compatible.</Description>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DotProlog.Compiler" />
        <InternalsVisibleTo Include="DotProlog.CodeGen.CSharp" />
        <InternalsVisibleTo Include="DotProlog.Runtime.Tests" />
        <InternalsVisibleTo Include="DotProlog.Syntax" />
    </ItemGroup>
</Project>
