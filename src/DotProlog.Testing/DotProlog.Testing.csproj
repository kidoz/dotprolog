<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>DotProlog.Testing</RootNamespace>

        <IsPackable>true</IsPackable>
        <PackageId>DotProlog.Testing</PackageId>
        <Title>DotProlog test framework</Title>
        <Description>Runs a Prolog project's test_* predicates under Microsoft.Testing.Platform.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Testing.Platform" Version="2.3.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DotProlog.Compiler\DotProlog.Compiler.csproj" />
    </ItemGroup>
</Project>
