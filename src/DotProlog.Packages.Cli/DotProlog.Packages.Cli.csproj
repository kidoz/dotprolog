<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="Version.props" />
    <PropertyGroup>
        <Version>$(PropackVersion)</Version>
        <OutputType>Exe</OutputType>
        <AssemblyName>propack</AssemblyName>
        <ToolCommandName>propack</ToolCommandName>
        <PackAsTool>true</PackAsTool>
        <!-- Release artifacts are explicitly requested; solution pack and release keep their existing package set. -->
        <IsPackable Condition="'$(PropackRelease)' == 'true'">true</IsPackable>
        <PackageId>DotProlog.Packages.Cli</PackageId>
        <Title>Portable Prolog package manager</Title>
        <Description>Restores locked Prolog source packages and runs them with SWI-Prolog or DotProlog.</Description>
        <IncludeSymbols>false</IncludeSymbols>
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
        <PublishDocumentationFiles>false</PublishDocumentationFiles>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../DotProlog.Packages/DotProlog.Packages.csproj" />
    </ItemGroup>
    <Target Name="RemovePropackDebugFiles" AfterTargets="Publish" BeforeTargets="PackTool" Condition="'$(_IsPacking)' == 'true'">
        <ItemGroup>
            <_PropackDebugFile Include="$(PublishDir)**/*.pdb;$(PublishDir)**/*.dbg;$(PublishDir)**/*.dSYM/**/*" />
        </ItemGroup>
        <Delete Files="@(_PropackDebugFile)" />
    </Target>
</Project>
